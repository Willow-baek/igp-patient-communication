        },
        {
          "speaker": "Patient",
          "turn": 4,
          "en": "Mostly in the middle of my lower back.",
          "ko": "주로 허리 아래쪽 한가운데요.",
          "audio": "audio/week-03/2026-11-09-v1/patient/04.m4a"
        },
        {
          "speaker": "Physio",
          "turn": 5,
          "en": "And when did you first notice it?",
          "ko": "처음 통증을 느끼신 건 언제인가요?",
          "audioVoices": {
            "female": "audio/week-03/volume-balanced-2026-11-09/2026-11-09-v1/female/05.m4a",
            "male": "audio/week-03/2026-11-09-v1/male/05.m4a"
          }
        },
        {
          "speaker": "Patient",
          "turn": 6,
