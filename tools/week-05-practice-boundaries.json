      ],
      "speaker": "Physio",
      "text": "I'd like to explain what I think might be going on with your back. Is that okay?",
      "sentences": [
        {
          "text": "I'd like to explain what I think might be going on with your back.",
          "range": {
            "start": 0,
            "end": 66
          },
          "chunks": [
            "I'd like to explain what I think might be going on",
